{
  "name": "scm-repository-filter",
  "displayName": "SCM Repository Filter",
  "publisher": "local",
  "version": "0.2.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cizhaYang/git-filter-repository.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:scmRepositoryFilter.changedRepositories",
    "onView:scmRepositoryFilter.changedFiles"
  ],
  "contributes": {
    "configuration": {
      "title": "SCM Repository Filter",
      "properties": {
        "scmRepositoryFilter.scanMode": {
          "type": "string",
          "enum": [
            "pinned",
            "all"
          ],
          "default": "pinned",
          "markdownDescription": "扫描模式。默认 `pinned`：只扫描/刷新固定的仓库，适合嵌套仓库很多、只关注少数仓库的工作区；`all`：递归扫描工作区下所有仓库（兼容旧行为）。"
        },
        "scmRepositoryFilter.pinnedRepositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "固定仓库列表（相对路径后缀，如 `acme/address`）。固定仓库无论在 `pinned` 还是 `all` 模式下都常驻显示。"
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "scmRepositoryFilter.changedRepositories",
          "name": "Changed Repositories",
          "icon": "$(repo)"
        },
        {
          "id": "scmRepositoryFilter.changedFiles",
          "name": "Changed Files",
          "icon": "$(files)"
        }
      ]
    },
    "commands": [
      {
        "command": "scmRepositoryFilter.refresh",
        "title": "Refresh Changed Repositories",
        "icon": "$(refresh)"
      },
      {
        "command": "scmRepositoryFilter.openRepository",
        "title": "Open Repository"
      },
      {
        "command": "scmRepositoryFilter.openGitGraph",
        "title": "View Git Graph",
        "icon": "$(history)"
      },
      {
        "command": "scmRepositoryFilter.openChange",
        "title": "Open Change"
      },
      {
        "command": "scmRepositoryFilter.commitStaged",
        "title": "Commit Staged",
        "icon": "$(git-commit)"
      },
      {
        "command": "scmRepositoryFilter.pull",
        "title": "Pull",
        "icon": "$(cloud-download)"
      },
      {
        "command": "scmRepositoryFilter.push",
        "title": "Push",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "scmRepositoryFilter.selectRepository",
        "title": "Select Repository"
      },
      {
        "command": "scmRepositoryFilter.stageChange",
        "title": "Stage",
        "icon": "$(add)"
      },
      {
        "command": "scmRepositoryFilter.unstageChange",
        "title": "Unstage",
        "icon": "$(remove)"
      },
      {
        "command": "scmRepositoryFilter.discardChange",
        "title": "Discard",
        "icon": "$(discard)"
      },
      {
        "command": "scmRepositoryFilter.stageAllChanges",
        "title": "Stage All Changes",
        "icon": "$(add)"
      },
      {
        "command": "scmRepositoryFilter.unstageAllChanges",
        "title": "Unstage All Changes",
        "icon": "$(remove)"
      },
      {
        "command": "scmRepositoryFilter.pinRepository",
        "title": "Pin Repository",
        "icon": "$(add)"
      },
      {
        "command": "scmRepositoryFilter.unpinRepository",
        "title": "Unpin Repository",
        "icon": "$(close)"
      },
      {
        "command": "scmRepositoryFilter.switchBranch",
        "title": "Switch Branch",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scmRepositoryFilter.refresh",
          "when": "view == scmRepositoryFilter.changedRepositories",
          "group": "navigation"
        },
        {
          "command": "scmRepositoryFilter.pinRepository",
          "when": "view == scmRepositoryFilter.changedRepositories",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "scmRepositoryFilter.switchBranch",
          "when": "view == scmRepositoryFilter.changedRepositories && (viewItem == changedRepository || viewItem == pinnedRepository)",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.commitStaged",
          "when": "view == scmRepositoryFilter.changedRepositories && (viewItem == changedRepository || viewItem == pinnedRepository)",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.pull",
          "when": "view == scmRepositoryFilter.changedRepositories && (viewItem == changedRepository || viewItem == pinnedRepository)",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.push",
          "when": "view == scmRepositoryFilter.changedRepositories && (viewItem == changedRepository || viewItem == pinnedRepository)",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.openGitGraph",
          "when": "view == scmRepositoryFilter.changedRepositories && viewItem == changedRepository",
          "group": "navigation"
        },
        {
          "command": "scmRepositoryFilter.unpinRepository",
          "when": "view == scmRepositoryFilter.changedRepositories && viewItem == pinnedRepository",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.stageChange",
          "when": "view == scmRepositoryFilter.changedFiles && (viewItem == changedFileWorkingTree || viewItem == changedFileUntracked)",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.unstageChange",
          "when": "view == scmRepositoryFilter.changedFiles && viewItem == changedFileIndex",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.discardChange",
          "when": "view == scmRepositoryFilter.changedFiles && (viewItem == changedFileWorkingTree || viewItem == changedFileUntracked)",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.stageAllChanges",
          "when": "view == scmRepositoryFilter.changedFiles && viewItem == changedGroupWorkingTree",
          "group": "inline"
        },
        {
          "command": "scmRepositoryFilter.unstageAllChanges",
          "when": "view == scmRepositoryFilter.changedFiles && viewItem == changedGroupIndex",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scmRepositoryFilter.changedRepositories",
        "contents": "No changed repositories were found."
      },
      {
        "view": "scmRepositoryFilter.changedFiles",
        "contents": "Select a changed repository to view its files."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npm run build && vsce package",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test",
    "test:unit": "node --test test/unit",
    "test:unit": "node --test test/unit",
    "harness:doctor": "node scripts/harness-doctor.mjs",
    "harness:new-change": "node scripts/new-change.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
